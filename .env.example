GUARDIAN_API_URL=http://127.0.0.1:8000
GUARDIAN_DB=backend/guardian.sqlite3
GUARDIAN_OSV_ENABLED=true

# Guardian Cognitive Intelligence (Gemini 1.0)
GUARDIAN_AI_ENABLED=false
GUARDIAN_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GUARDIAN_AI_TIMEOUT_SECONDS=30
GUARDIAN_AI_MAX_TURNS=30

# Guardian 4.0 GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Optional: path to private key PEM file instead of inline PEM
# GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALL_URL=
GITHUB_API_BASE=https://api.github.com

# Guardian accounts — fill these two public values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server overrides; blank uses the NEXT_PUBLIC values above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase PostgreSQL connection. Never prefix with NEXT_PUBLIC.
# Use the dashboard pooler URL with sslmode=require; URL-encode password characters.
GUARDIAN_DATABASE_URL=
# sqlite is an explicit local development fallback using GUARDIAN_DB; cloud requires PostgreSQL.
GUARDIAN_ACCOUNT_STORE=sqlite
GUARDIAN_FRONTEND_URL=http://127.0.0.1:3000
GUARDIAN_PUBLIC_API_URL=http://127.0.0.1:8000
GUARDIAN_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# true for both deployed frontend/backend; blocks local source/GitHub APIs on the public service.
GUARDIAN_CLOUD_MODE=false
# Explicit plaintext credential fallback; prefer guardian login with OS credential manager.
GUARDIAN_ALLOW_FILE_CREDENTIALS=false
